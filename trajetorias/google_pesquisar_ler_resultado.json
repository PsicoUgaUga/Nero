    "micro_abrir_google",
    "micro_pesquisar_google"
  ],
  "passos": [
    {
      "ferramenta": "navegar",
      "params": {
        "url": "https://www.google.com"
      }
    },
    {
      "ferramenta": "preencher_campo",
      "params": {
        "descricao": "q",
        "valor": "{termo}"
      }
    },
    {
      "ferramenta": "pressionar",
      "params": {
        "tecla": "Enter"
      }
    },
    {
      "ferramenta": "esperar",
      "params": {
        "segundos": 2
      }
    },
    {
      "ferramenta": "ler_pagina_estruturada",
      "params": {}
    }
  ]
}