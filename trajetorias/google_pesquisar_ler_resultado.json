    "termo"
  ],
  "exemplo_original": "pesquisa piada do dia no google",
  "descricao_rag": "Abre o Google, pesquisa um termo e retorna o conteúdo estruturado da página de resultados. Útil pra buscar informação rápida no Google, mostrando títulos e links.",
  "criado_em": "2026-10-16 10:00:00",
  "criado_por": "manual",
  "tipo": "composta",
